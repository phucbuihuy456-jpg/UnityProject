--- !u!114 &1460000008
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1460000001}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2bf9905ec63646169d3d185b1b364e38, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BossDefeatDialogue
  dialogue:
  - speaker: "K\u1EBB Gi\u1EEF \u0110\xE8n"
    text: "Kh\u1EE5... kh\u1EE5... Ch\xE1u y\xEAu... \u0111\xF4i tay \u1EA5y... v\u1EABn
      \u1EA5m nh\u01B0 c\xE1i \u0111\xEAm b\xE0 b\u1EBF ch\xE1u r\u1EDDi kh\u1ECFi
      n\u01A1i n\xE0y..."
  - speaker: Elara
    text: "\u0110\u1EEBng g\u1ECDi ta nh\u01B0 v\u1EADy! Su\u1ED1t tr\u1EADn \u0111\xE1nh
      ng\u01B0\u01A1i c\u1EE9 g\u1ECDi ta b\u1EB1ng c\xE1i t\xEAn ta ch\u01B0a t\u1EEBng
      nghe. R\u1ED1t cu\u1ED9c ng\u01B0\u01A1i l\xE0 ai?"
  - speaker: "K\u1EBB Gi\u1EEF \u0110\xE8n"
    text: "Chi\u1EBFc \u0111\xE8n... v\u1EE1 m\u1EA5t r\u1ED3i... Ch\xE1u t\u1EF1
      nh\xECn \u0111i... B\xEAn trong n\xF3... ch\u01B0a bao gi\u1EDD l\xE0 l\u1EEDa..."
  - speaker: Elara
    text: "M\u1ED9t b\u1EE9c \u1EA3nh...? \u0110\u1EE9a b\xE9 trong \u1EA3nh n\xE0y...
      T\u1EA1i sao... t\u1EA1i sao n\xF3 c\xF3 g\u01B0\u01A1ng m\u1EB7t c\u1EE7a
      ta?!"
  - speaker: "K\u1EBB Gi\u1EEF \u0110\xE8n"
    text: "M\u1EB7t sau b\u1EE9c \u1EA3nh... c\xF3 d\xF2ng ch\u1EEF b\xE0 kh\u1EAFc
      n\u0103m 2003... '\u0110\u1EC3 b\xE0 t\u1EF1 \u0111\u1ED1t m\xECnh trong b\xF3ng
      t\u1ED1i, mi\u1EC5n l\xE0 ch\xE1u \u0111\u01B0\u1EE3c s\u1ED1ng.'... \u0110\xEAm
      \u0111\xF3 ch\xE1u m\u1EDBi b\u1ED1n tu\u1ED5i... Vesper \xE0."
  - speaker: Elara
    text: "Vesper...? Kh\xF4ng th\u1EC3 n\xE0o... Vesper l\xE0 t\xEAn c\u1EE7a c\xE2y
      n\u1EBFn..."
  - speaker: Vesper Wickwood
    text: "C\xE2y n\u1EBFn mang t\xEAn ch\xE1u \u0111\u1EA5y, ch\xE1u y\xEAu... Ta
      l\xE0 Vesper Wickwood \u2014 b\xE0 n\u1ED9i c\u1EE7a ch\xE1u. C\xF2n l\xE2u
      \u0111\xE0i n\xE0y... l\xE0 n\u01A1i ch\xE1u sinh ra."
  - speaker: Elara
    text: "N\xF3i d\u1ED1i! H\u1ED9i b\u1EA3o cha m\u1EB9 ta ch\u1EBFt v\xEC tai
      n\u1EA1n! Ta l\xE0 th\u1EE3 s\u0103n c\u1EE7a H\u1ED9i Canh Gi\u1EEF, ta \u0111\u1EBFn
      \u0111\xE2y \u0111\u1EC3 ch\u1EA5m d\u1EE9t l\u1EDDi nguy\u1EC1n!"
  - speaker: Vesper Wickwood
    text: "H\u1ED9i Canh Gi\u1EEF kh\xF4ng c\u1EE9u th\u1EBF gi\u1EDBi \u0111\xE2u,
      ch\xE1u \xE0... H\u1ECD \u0111\u01B0a ch\xE1u v\u1EC1 \u0111\xFAng c\xE1i n\u01A1i
      b\xE0 \u0111\xE3 \u0111\xE1nh \u0111\u1ED5i t\u1EA5t c\u1EA3 \u0111\u1EC3 ch\xE1u
      tr\u1ED1n tho\xE1t... \u0110i ti\u1EBFp \u0111i... nh\u01B0ng khi '\xF4ng \u1EA5y'
      g\u1ECDi ch\xE1u b\u1EB1ng h\u1ECD Wickwood... \u0111\u1EEBng tin... b\u1EA5t
      c\u1EE9... l\u1EDDi n\xE0o..."
  - speaker: Elara
    text: "B\xE0 \u01A1i\u2014khoan \u0111\xE3!... T\u1EA1i sao... ta kh\xF4ng kh\xF3c
      \u0111\u01B0\u1EE3c... T\u1EA1i sao ta kh\xF4ng th\u1EC3 kh\xF3c?"
  startDelay: 0.4
  typeSpeed: 0.04
  fadeOutDuration: 2
  advanceKey: 13
  lockPlayerWhileTalking: 1
  destroyBossWhenDone: 1
  onDialogueComplete:
    m_PersistentCalls:
      m_Calls: []
  typingSound: {fileID: 8300000, guid: a1c2e3f40b5d4a6c8e9f0a1b2c3d4e5f, type: 3}
  voiceVolume: 0.7
  nameFontSize: 28
