--- !u!114 &1470000008
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1470000001}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ca64af6519b64d989271885b18a097fd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::VampireLordEndingDialogue
  introDialogue:
  - speaker: Lord Wickwood
    text: "Kh\u1EE5... Tuy\u1EC7t v\u1EDDi... tuy\u1EC7t v\u1EDDi l\u1EAFm, ch\xE1u
      y\xEAu c\u1EE7a ta... N\u0103m tr\u0103m n\u0103m r\u1ED3i... d\xF2ng m\xE1u
      Wickwood ch\u01B0a bao gi\u1EDD ch\u1EA3y m\u1EA1nh m\u1EBD \u0111\u1EBFn th\u1EBF..."
  - speaker: Elara
    text: "\u0110\u1EE7 r\u1ED3i, Albrecht Wickwood! Ng\u01B0\u01A1i \u0111\xE3 nu\u1ED1t
      ch\u1EEDng b\u1EA3y cu\u1ED9c \u0111\u1EDDi. B\u1EA3y ng\u01B0\u1EDDi con g\xE1i
      c\u1EE7a ch\xEDnh d\xF2ng h\u1ECD ng\u01B0\u01A1i. H\xF4m nay, m\u1ECDi chuy\u1EC7n
      k\u1EBFt th\xFAc."
  - speaker: Lord Wickwood
    text: "K\u1EBFt th\xFAc...? Ch\xE1u v\u1EABn ch\u01B0a hi\u1EC3u sao? C\xE2y
      n\u1EBFn ch\xE1u c\u1EA7m ch\u01B0a bao gi\u1EDD l\xE0 v\u0169 kh\xED... N\xF3
      l\xE0 CH\xCCA KH\xD3A. M\u1ED7i th\u1EE3 s\u0103n tr\u1EDF v\u1EC1, m\u1ED7i
      ng\u1ECDn n\u1EBFn ch\xE1y h\u1EBFt... ta l\u1EA1i m\u1EA1nh th\xEAm m\u1ED9t
      ch\xFAt."
  - speaker: Lord Wickwood
    text: "H\u1ED9i Canh Gi\u1EEF kh\xF4ng c\u1EED ch\xE1u \u0111\u1EBFn \u0111\u1EC3
      gi\u1EBFt ta... Ch\xFAng MANG CH\xC1U V\u1EC0 cho ta. Nh\u01B0 \u0111\xE3 mang
      v\u1EC1 b\u1EA3y \u0111\u1EE9a tr\u01B0\u1EDBc. Ch\xFAng nu\xF4i ch\xE1u, d\u1EA1y
      ch\xE1u, r\u1ED3i d\xE2ng ch\xE1u \u2014 \u0111\xFAng n\u0103m ch\xE1u hai
      m\u01B0\u01A1i ba tu\u1ED5i."
  - speaker: Lord Wickwood
    text: "Nh\xECn ta n\xE0y, Vesper Wickwood... Ta \u0111ang qu\u1EF3 tr\u01B0\u1EDBc
      ch\xE1u \u0111\xE2y. Ngai v\xE0ng, l\xE2u \u0111\xE0i, s\u1EF1 b\u1EA5t t\u1EED
      \u2014 t\u1EA5t c\u1EA3 l\xE0 c\u1EE7a ch\xE1u. Ch\xE1u ch\u1EC9 c\u1EA7n...
      \u0111\u01B0a ng\u1ECDn n\u1EBFn v\u1EC1 ngu\u1ED3n c\u1EE7a n\xF3."
  choicePrompt: "Elara s\u1EBD tr\u1EA3 l\u1EDDi th\u1EBF n\xE0o?"
  choices:
  - choiceText: "D\xF2ng h\u1ECD Wickwood k\u1EBFt th\xFAc t\u1EA1i \u0111\xE2y \u2014
      b\u1EB1ng ng\u1ECDn l\u1EEDa cu\u1ED1i c\xF9ng c\u1EE7a n\xF3."
    epilogue:
    - speaker: Elara
      text: "B\xE0 n\u1ED9i \u0111\xE3 t\u1EF1 \u0111\u1ED1t m\xECnh trong b\xF3ng
        t\u1ED1i \u0111\u1EC3 ta \u0111\u01B0\u1EE3c s\u1ED1ng. Gi\u1EDD ta m\u1EDBi
        hi\u1EC3u... \xC1nh s\xE1ng kh\xF4ng ph\u1EA3i th\u1EE9 \u0111\u1EC3 gi\u1EEF
        l\u1EA5y. N\xF3 l\xE0 th\u1EE9 \u0111\u1EC3 trao \u0111i."
    - speaker: Lord Wickwood
      text: "Khoan... ch\xE1u \u0111\u1ECBnh l\xE0m g\xEC...? D\u1EEANG L\u1EA0I!
        Ch\xE1u l\xE0 T\xC0I S\u1EA2N c\u1EE7a ta! Ch\xE1u ch\xEDnh l\xE0 TA!"
    - speaker: Elara
      text: "Kh\xF4ng. Ta l\xE0 \xE1nh s\xE1ng cu\u1ED1i c\xF9ng c\u1EE7a d\xF2ng
        h\u1ECD Wickwood. V\xE0 \xE1nh s\xE1ng n\xE0y... kh\xF4ng thu\u1ED9c v\u1EC1
        ng\u01B0\u01A1i."
    endingTitle: "\xC1NH S\xC1NG"
    endingNarration: "Elara \xE1p C\xE2y N\u1EBFn Vesper v\xE0o ng\u1EF1c m\xECnh.
      Ng\u1ECDn l\u1EEDa lan ra \u2014 tr\u1EAFng x\xF3a, \u1EA5m \xE1p, kh\xF4ng
      h\u1EC1 \u0111au \u0111\u1EDBn.\n\nLord Wickwood g\xE0o l\xEAn r\u1ED3i tan
      th\xE0nh tro b\u1EE5i. M\u1ED9t tr\u0103m ng\u1ECDn ma tr\u01A1i bay ra kh\u1ECFi
      l\xE2u \u0111\xE0i, h\u01B0\u1EDBng v\u1EC1 b\u1EA7u tr\u1EDDi nh\u01B0 m\u1ED9t
      d\xF2ng sao b\u0103ng ng\u01B0\u1EE3c. Trong \xE1nh ban mai \u0111\u1EA7u ti\xEAn
      sau n\u0103m tr\u0103m n\u0103m, l\xE2u \u0111\xE0i Wickwood s\u1EE5p \u0111\u1ED5.\n\nTr\xEAn
      bia m\u1ED9 th\u1EE9 t\xE1m trong tu vi\u1EC7n, c\xF3 d\xF2ng ch\u1EEF m\u1EDBi:\n\n\"Elara
      Vespera Wickwood.\nNg\u01B0\u1EDDi cu\u1ED1i c\xF9ng c\u1EE7a d\xF2ng h\u1ECD.\nNg\u01B0\u1EDDi
      \u0111\u1EA7u ti\xEAn ch\u1ECDn \xE1nh s\xE1ng.\""
    onChosen:
      m_PersistentCalls:
        m_Calls: []
  - choiceText: "Ngai v\xE0ng \u0111\xF3 l\xE0 c\u1EE7a ta. Ta l\xE0 Vesper Wickwood."
    epilogue:
    - speaker: Elara
      text: "N\u0103m tr\u0103m n\u0103m... t\xE1m th\u1EBF h\u1EC7... Ng\u01B0\u01A1i
        n\xF3i \u0111\xFAng m\u1ED9t \u0111i\u1EC1u, Albrecht: kh\xF4ng ai tr\u1ED1n
        \u0111\u01B0\u1EE3c c\u1ED9i ngu\u1ED3n c\u1EE7a m\xECnh."
    - speaker: Lord Wickwood
      text: "\u0110\xFAng v\u1EADy... \u0111\xFAng v\u1EADy... V\u1EC1 nh\xE0 \u0111i,
        ch\xE1u y\xEAu c\u1EE7a ta..."
    - speaker: Elara
      text: "Nh\u01B0ng ng\u01B0\u01A1i nh\u1EA7m m\u1ED9t \u0111i\u1EC1u. Ngai v\xE0ng
        n\xE0y kh\xF4ng ph\u1EA3i ng\u01B0\u01A1i ban cho ta... N\xF3 l\xE0 C\u1EE6A
        TA. V\xE0 k\u1EBB \u0111\u1EA7u ti\xEAn b\xF3ng t\u1ED1i n\xE0y nu\u1ED1t
        ch\u1EEDng \u2014 ch\xEDnh l\xE0 ng\u01B0\u01A1i."
    endingTitle: "B\xD3NG T\u1ED0I"
    endingNarration: "Elara ng\u1ED3i l\xEAn ngai v\xE0ng. C\xE2y N\u1EBFn Vesper
      b\xF9ng ch\xE1y m\xE3nh li\u1EC7t h\u01A1n bao gi\u1EDD h\u1EBFt \u2014 v\xE0
      b\xF3ng t\u1ED1i qu\u1EF3 xu\u1ED1ng d\u01B0\u1EDBi ch\xE2n n\xF3.\n\n\u1EDE
      m\u1ED9t n\u01A1i r\u1EA5t xa, m\u1ED9t b\xE9 g\xE1i v\u1EEBa ch\xE0o \u0111\u1EDDi
      trong m\u1ED9t gia \u0111\xECnh b\xECnh th\u01B0\u1EDDng \u2014 mang trong
      m\xECnh d\xF2ng m\xE1u Wickwood m\xE0 kh\xF4ng ai hay bi\u1EBFt.\n\nTrong gi\u1EA5c
      ng\u1EE7 \u0111\u1EA7u ti\xEAn c\u1EE7a em, c\xF3 ti\u1EBFng th\xEC th\u1EA7m:\n\n\"H\u1EB9n
      g\u1EB7p l\u1EA1i sau 70 n\u0103m, ch\xE1u y\xEAu.\""
    onChosen:
      m_PersistentCalls:
        m_Calls: []
  - choiceText: "Ta kh\xF4ng gi\u1EBFt ng\u01B0\u01A1i. Ta c\u0169ng kh\xF4ng nh\u1EADn
      ngai v\xE0ng. Ta s\u1EBD \u1EDF l\u1EA1i \u2014 canh gi\u1EEF n\u01A1i n\xE0y,
      m\xE3i m\xE3i."
    epilogue:
    - speaker: Lord Wickwood
      text: "C\xE1i g\xEC...? Kh\xF4ng gi\u1EBFt... c\u0169ng kh\xF4ng nh\u1EADn
        l\u1EA5y...? KH\xD4NG AI \u0111\u01B0\u1EE3c ph\xE9p t\u1EEB ch\u1ED1i d\xF2ng
        m\xE1u Wickwood!"
    - speaker: Elara
      text: "M\u1ED9t tr\u0103m \u0111\u1EE9a tr\u1EBB ng\u01B0\u01A1i \u0111\xE3
        d\xE2ng \u0111i \u2014 ta \u0111\xE3 nh\u1EB7t t\u1EEBng ng\u1ECDn l\u1EEDa,
        \u0111\u01B0a t\u1EEBng \u0111\u1EE9a v\u1EC1 v\u1EDBi \xE1nh s\xE1ng. Ch\xFAng
        d\u1EA1y ta \u0111i\u1EC1u ng\u01B0\u01A1i kh\xF4ng bao gi\u1EDD hi\u1EC3u:
        b\xF3ng t\u1ED1i kh\xF4ng c\u1EA7n b\u1ECB ti\xEAu di\u1EC7t. N\xF3 ch\u1EC9
        c\u1EA7n \u0111\u01B0\u1EE3c th\u1EAFp s\xE1ng."
    - speaker: Elara
      text: "N\u1EBFu \xE1nh s\xE1ng c\u1EA7n m\u1ED9t ng\u01B0\u1EDDi canh gi\u1EEF,
        th\xEC ng\u01B0\u1EDDi \u0111\xF3 l\xE0 ta. Kh\xF4ng ai kh\xE1c n\u1EEFa
        ph\u1EA3i \u0111\u1EBFn \u0111\xE2y."
    endingTitle: "NG\u01AF\u1EDCI CANH GI\u1EEE"
    endingNarration: "Elara \u1EDF l\u1EA1i. Kh\xF4ng ph\u1EA3i t\xF9 nh\xE2n \u2014
      m\xE0 l\xE0 Ng\u01B0\u1EDDi Gi\u1EEF S\xE1ng m\u1EDBi c\u1EE7a Wickwood Manor.\n\nTrong
      s\u1EA3nh ch\xEDnh, c\xF4 ng\u1ED3i gi\u1EEFa m\u1ED9t tr\u0103m ng\u1ECDn
      ma tr\u01A1i nh\u1ECF bay quanh nh\u01B0 sao tr\u1EDDi. C\xE2y n\u1EBFn ch\xE1y
      b\xECnh y\xEAn. C\xF4 kh\u1EBD h\xE1t b\xE0i h\xE1t ru b\u1EB1ng th\u1EE9 ng\xF4n
      ng\u1EEF c\xF4 ch\u01B0a t\u1EEBng \u0111\u01B0\u1EE3c h\u1ECDc \u2014 ng\xF4n
      ng\u1EEF c\u1EE7a t\u1ED5 ti\xEAn.\n\nV\xE0 l\u1EA7n \u0111\u1EA7u ti\xEAn
      trong \u0111\u1EDDi,\nElara kh\xF4ng c\xF2n c\xF4 \u0111\u01A1n n\u1EEFa."
    onChosen:
      m_PersistentCalls:
        m_Calls: []
  secretChoiceIndex: 2
  flamesRequiredForSecret: 75
